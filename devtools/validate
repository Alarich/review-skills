#!/usr/bin/env python3
"""Run the repository validation checks in filename order."""

from pathlib import Path
import subprocess
import sys


def main():
    devtools = Path(__file__).resolve().parent
    check_directory = devtools / "validate.d"
    checks = sorted(path for path in check_directory.glob("*.py") if path.is_file())
    if not checks:
        print("No validation checks found.", file=sys.stderr)
        return 1

    failed = []
    for check in checks:
        print(f"==> {check.name}", flush=True)
        result = subprocess.run([sys.executable, str(check)], cwd=devtools.parent)
        if result.returncode:
            failed.append(check.name)

    if failed:
        print(f"Validation failed: {', '.join(failed)}", file=sys.stderr)
        return 1
    print("All checks passed.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
